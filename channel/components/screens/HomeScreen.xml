<?xml version="1.0" encoding="utf-8" ?>
<!-- Home: tab bar over the tab's content -- a four-column video grid for the feeds,
     history and favourites, the QR login (我的, logged out) or the settings rows. -->
<component name="HomeScreen" extends="Group">
  <interface>
    <!-- {tab, row}: where to land after MainScene rebuilds this screen for a new font -->
    <field id="resume" type="assocarray" onChange="onResume" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/common/utils.brs" />
  <script type="text/brightscript" uri="HomeScreen.brs" />
  <children>
    <Poster uri="pkg:/images/logo.png" translation="[78,30]" width="84" height="70" />
    <Label id="brand" translation="[170,42]" text="狗哩狗哩" />
    <Group id="tabs" translation="[440,34]" />
    <Label id="account" translation="[1330,48]" width="500" horizAlign="right" color="0x8E8E9EFF" />
    <Label id="hint" translation="[1330,96]" width="500" horizAlign="right" color="0x6E6E7EFF" visible="false" />
    <MarkupGrid id="grid" translation="[90,170]" itemComponentName="VideoCard"
                numColumns="4" numRows="3" itemSize="[414,352]" itemSpacing="[28,36]"
                drawFocusFeedback="false" vertFocusAnimationStyle="fixedFocus" />
    <Label id="message" translation="[160,470]" width="1600" horizAlign="center"
           wrap="true" color="0x8E8E9EFF" visible="false" />
    <BusySpinner id="spinner" translation="[928,500]" visible="false" />
    <LoginPanel id="login" visible="false" />
    <SettingsPanel id="settings" visible="false" />

    <!-- 我的 when logged in: account card on top, favourite folders below -->
    <Group id="meBox" visible="false">
      <Poster uri="pkg:/images/card.9.png" translation="[90,140]" width="1740" height="200" />
      <Poster id="avatar" translation="[130,170]" width="140" height="140" loadWidth="160" loadHeight="160"
              loadDisplayMode="scaleToZoom" loadingBitmapUri="pkg:/images/placeholder.png" failedBitmapUri="pkg:/images/placeholder.png" />
      <Poster uri="pkg:/images/avatar_mask.png" translation="[130,170]" width="140" height="140" />
      <Label id="uname" translation="[310,172]" width="1000" maxLines="1" color="0xFFFFFFFF" />
      <Label id="badges" translation="[310,238]" width="1000" maxLines="1" />
      <Label id="meStats" translation="[310,282]" width="1000" maxLines="1" color="0x8E8E9EFF" />
      <Label id="meHint" translation="[1290,282]" width="500" horizAlign="right" color="0x6E6E7EFF" />
      <Label id="favTitle" translation="[96,372]" color="0xFFFFFFFF" />
      <MarkupGrid id="folders" translation="[90,430]" itemComponentName="VideoCard"
                  numColumns="4" numRows="2" itemSize="[414,352]" itemSpacing="[28,36]"
                  drawFocusFeedback="false" vertFocusAnimationStyle="fixedFocus" />
    </Group>
    <ActionMenu id="menu" visible="false" />
  </children>
</component>
