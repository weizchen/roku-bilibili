<?xml version="1.0" encoding="utf-8" ?>
<!-- An uploader's page, opened from a video page. uploader = {mid, name}. -->
<component name="UpScreen" extends="Group">
  <interface>
    <field id="uploader" type="assocarray" onChange="onUploader" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/common/utils.brs" />
  <script type="text/brightscript" uri="UpScreen.brs" />
  <children>
    <Poster uri="pkg:/images/card.9.png" translation="[90,40]" width="1740" height="210" />
    <Poster id="avatar" translation="[130,75]" width="140" height="140" loadWidth="160" loadHeight="160"
            loadDisplayMode="scaleToZoom" loadingBitmapUri="pkg:/images/placeholder.png" failedBitmapUri="pkg:/images/placeholder.png" />
    <Poster uri="pkg:/images/avatar_mask.png" translation="[130,75]" width="140" height="140" />
    <Label id="name" translation="[310,72]" width="960" maxLines="1" color="0xFFFFFFFF" />
    <Label id="stats" translation="[310,136]" width="960" maxLines="1" />
    <Label id="sign" translation="[310,180]" width="960" maxLines="1" color="0x8E8E9EFF" />
    <ButtonGroup id="order" translation="[1330,103]" layoutDirection="horiz" itemSpacings="[16]"
                 minWidth="230" buttonHeight="72"
                 focusFootprintBitmapUri="pkg:/images/pill_dim.9.png"
                 iconUri="" focusedIconUri=""
                 textColor="0xE6E6EBFF" />
    <MarkupGrid id="grid" translation="[90,300]" itemComponentName="VideoCard"
                numColumns="4" numRows="2" itemSize="[414,352]" itemSpacing="[28,36]"
                drawFocusFeedback="false" vertFocusAnimationStyle="fixedFocus" />
    <Label id="message" translation="[160,600]" width="1600" horizAlign="center" wrap="true" color="0x8E8E9EFF" visible="false" />
    <BusySpinner id="spinner" translation="[928,600]" />
  </children>
</component>
