<?xml version="1.0" encoding="utf-8" ?>
<!-- Talks to bilibili directly from the TV. op + params in, {ok, data, error} out. -->
<component name="BiliTask" extends="Task">
  <interface>
    <field id="op" type="string" />
    <field id="params" type="assocarray" />
    <field id="tag" type="string" />
    <field id="response" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/common/utils.brs" />
  <script type="text/brightscript" uri="http.brs" />
  <script type="text/brightscript" uri="text.brs" />
  <script type="text/brightscript" uri="media.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/fmp4.brs" />
  <script type="text/brightscript" uri="qr.brs" />
  <script type="text/brightscript" uri="ops.brs" />
</component>
