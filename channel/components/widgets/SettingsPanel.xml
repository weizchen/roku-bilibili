<?xml version="1.0" encoding="utf-8" ?>
<!-- Settings rows shown right under the home tab bar: theme, font, danmaku defaults.
     Left/right changes a row and applies at once. `active` = it holds focus. -->
<component name="SettingsPanel" extends="Group">
  <interface>
    <field id="active" type="boolean" onChange="paint" />
    <field id="row" type="integer" onChange="onRow" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/common/utils.brs" />
  <script type="text/brightscript" uri="SettingsPanel.brs" />
  <children>
    <Label id="hint" translation="[96,150]" text="按「下」进入，上下选择，左右调整，马上生效" color="0x8E8E9EFF" />
    <Group id="rows" translation="[80,210]" />

    <!-- live preview of the accent -->
    <Group translation="[1180,210]">
      <Poster uri="pkg:/images/card.9.png" width="620" height="460" />
      <Poster uri="pkg:/images/logo.png" translation="[50,48]" width="120" height="100" />
      <Label id="previewBrand" translation="[190,70]" text="狗哩狗哩" />
      <Poster id="previewPill" translation="[50,200]" width="260" height="76" />
      <Label id="previewPillText" translation="[50,200]" width="260" height="76" horizAlign="center" vertAlign="center" text="▶  播放" />
      <Rectangle id="previewBarBg" translation="[50,330]" width="520" height="8" color="0xFFFFFF33" />
      <Rectangle id="previewBar" translation="[50,330]" width="300" height="8" />
      <Label id="previewText" translation="[50,370]" width="520" text="影视飓风    2天前" />
    </Group>
  </children>
</component>
